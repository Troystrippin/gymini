# ─── Server ─────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ───────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gymini

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-different-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Login lockout ──────────────────────────────────
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TTL_MIN=10
PASSWORD_RESET_TTL_MIN=15

# ─── SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=GYMINI <no-reply@gymini.app>

# ─── CORS ───────────────────────────────────────────
ALLOWED_ORIGINS=