{
  "expo": {
    "name": "GYMINI",
    "slug": "gymini",
    "version": "1.0.1",
    "orientation": "portrait",
    "backgroundColor": "#0D0D0D",
    "icon": "./assets/GYMINI logo Splash.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.troyystrppn.gymini"
    },
    "android": {
      "package": "com.troyystrppn.gymini",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/GYMINI logo Splash.png"
      }
    },
    "web": {
      "favicon": "./assets/GYMINI logo Splash.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GYMINI to select profile and exercise photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c64c3298-b7fe-40b1-b533-580be3090603"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
