{
  "expo": {
    "name": "GYMINI",
    "slug": "gymini",
    "owner": "gymini",
    "version": "1.0.1",
    "orientation": "portrait",
    "backgroundColor": "#0D0D0D",
    "icon": "./assets/GYMINI logo Splash.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.troyystrppn.gymini"
    },
    "android": {
      "package": "com.troyystrppn.gymini",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/GYMINI logo Splash.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/GYMINI logo Splash.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.739890437061-l7k645rp1cik7kic2hq8srh37ok8cicv"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GYMINI to select profile and exercise photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c67db098-4f25-4536-92e1-84648febd797"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
